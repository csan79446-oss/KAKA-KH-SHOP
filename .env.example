# Environment variables for KAKA KH SHOP Telegram MiniApp & Admin
# Supabase PostgreSQL connection strings (from Project Settings -> Database)
# Transaction pooler (port 6543) for serverless queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for Prisma migrations & db push:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Telegram Bot configuration (obtain from @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_BOT_USERNAME="kaka_kh_shop_bot"

# Admin Dashboard PIN Protection (default: 1234)
NEXT_PUBLIC_ADMIN_PIN="1234"
ADMIN_SECRET_KEY="supersecretadminpassword123"
